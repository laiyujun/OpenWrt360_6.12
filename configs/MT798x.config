# TARGET config: MediaTek Filogic (mt7981 / mt7986 系列机器)
# 源码: VIKINGYFY/immortalwrt @ owrt 分支 (6.18 内核) —— 与 IPQ53XX(53xx) 同源码、同分支。
#
# 关于此前 MT798x 编译失败(run 43377812567)的真正根因(已核对 VIKINGYFY/owrt 全树源码):
#   firewall4(Base system 默认防火墙, 必然被选中) 的 DEPENDS 同时写了
#   +kmod-nf-conntrack-bridge 与 +kmod-nft-bridge; 而这两个包都打包同一个 nf_conntrack_bridge.ko
#   (kmod-nft-bridge 经 include/netfilter.mk 的 NFT_BRIDGE 模块组包含它)。两者同入设备 rootfs 时,
#   opkg 的 check_data_file_clashes 会因"两个包争抢同一 .ko"而中止 package/install —— MT798x 挂在此处。
#   IPQ53XX(53xx) 用同源码却不报错, 是因为其内核未开启 CONFIG_NF_CONNTRACK_BRIDGE,
#   故 kmod-nft-bridge 不会把 nf_conntrack_bridge.ko 编入, 即便两包都被选中也不会产生文件冲突。
#   正确修复(对齐 immortalwrt 官方 master): 在 WRT-CORE.yml 构建期补丁中, 仅移除 firewall4 里冗余的
#   +kmod-nf-conntrack-bridge 依赖(该 .ko 仍由 kmod-nft-bridge 提供, 依赖链完整), 并顺带删除冗余包定义。
#   注意: 早期"直接删除 kmod-nf-conntrack-bridge 包"会破坏 firewall4 依赖链, 反而编译失败, 已废弃。
#
# 布局(已依据 VIKINGYFY/owrt filologic.mk 逐设备核对: 25 profile 实为 3 类, 并非"全 stock"):
#   A 类 保留原厂 U-Boot(stock 布局, 不产 FIP, 直接刷 *-sysupgrade.bin / *-factory.bin):
#       4 个 *-stock 变体(cetron_ct3003-stock / xiaomi_mi-router-ax3000t-stock /
#       xiaomi_mi-router-wr30u-stock / xiaomi_redmi-router-ax6000-stock)
#       + 3 个单 profile stock 设备(glinet_gl-mt3000 / ruijie_rg-x60-pro / zyxel_ex5700-telenor) — 共 7 个
#   B 类 单 profile = OpenWrt U-Boot 路线(产 FIP + *-sysupgrade.itb, 需先刷 preloader.bin + bl31-uboot.fip 装 OpenWrt U-Boot):
#       abt_asr3000 / cmcc_rax3000m / cmcc_rax3000me / glinet_gl-mt2500 / netcore_n60 / qihoo_360t7 /
#       jcg_q30-pro / nokia_ea0326gmp / bananapi_bpi-r3-mini / glinet_gl-mt6000 / jdcloud_re-cp-03 /
#       netcore_n60-pro / tplink_tl-xdr6086 / tplink_tl-xdr6088 — 共 14 个(部分含多闪存/内存变体)
#   C 类 双 profile(同机型另有 stock 兄弟在 A 类, 此处 ubootmod 分支在 B 类, 二选一):
#       cetron_ct3003-ubootmod / xiaomi_mi-router-ax3000t-ubootmod /
#       xiaomi_mi-router-wr30u-ubootmod / xiaomi_redmi-router-ax6000-ubootmod — 共 4 个
#   说明: FIP 文件名前缀(emmc-/nand-/ubi-/ddr3-/ddr4-)是硬件变体(闪存/内存), 非"stock vs ubootmod";
#       仅 ubootmod 分支的 FIP 带 -ubootmod 后缀。stock 保留原厂 U-Boot, ubootmod 换 OpenWrt U-Boot。
#   刷机铁律: stock 布局用 *-stock-* 镜像; OpenWrt U-Boot 布局用 *-ubootmod-* / 对应 itb; 二者严禁混用(混用=变砖)。
# 共享 configs/General.config 已含 CONFIG_TARGET_MULTI_PROFILE=y / CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 使用 opkg 包管理器（与既有 mt798x 配置 RAX3000M.config 保持一致，避免 APK 相关坑）
CONFIG_USE_APK=n

# 冲突消解: 冗余 kmod-nf-conntrack-bridge 依赖已由 WRT-CORE.yml 构建期补丁从 firewall4 移除
# (该 .ko 改由 kmod-nft-bridge 独占提供), 此处无需再设 =n, 也不删除包定义(firewall4 依赖链已完整)。

# ===================== mt7981 系列 (stock) =====================
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_abt_asr3000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cetron_ct3003-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cetron_ct3003-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000me=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt2500=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt3000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_jcg_q30-pro=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_nokia_ea0326gmp=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-ubootmod=y

# ===================== mt7986 系列 (stock) =====================
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r3-mini=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt6000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_jdcloud_re-cp-03=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60-pro=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_tl-xdr6086=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_tl-xdr6088=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_ruijie_rg-x60-pro=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_zyxel_ex5700-telenor=y
