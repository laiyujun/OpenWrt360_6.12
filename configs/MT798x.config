# TARGET config: MediaTek Filogic (mt7981 / mt7986 系列机器)
# 源码: immortalwrt/immortalwrt @ master 分支 (6.18 内核)
# 变更说明: 原选定 VIKINGYFY/immortalwrt@owrt 存在上游 bug —— 其 kmod-nft-bridge 与
#   kmod-nf-conntrack-bridge 重复打包同一文件 nf_conntrack_bridge.ko，导致 opkg 文件冲突、
#   package/install 阶段失败 (run 43377812567)。改回 immortalwrt 官方 master: 其 nft.mk
#   为标准实现 (kmod-nft-bridge 只装 nft_bridge.ko，不冲突)，且已在 #153 的 x86-64 6.18 验证。
# 布局: 主选 stock 变体，兼容 hanwckf 默认 U-Boot（刷机选 *-stock-squashfs-sysupgrade.bin；
#       ubootmod 对 hanwckf 默认 U-Boot 会变砖）；4 款含 ubootmod 变体的机型额外产出
#       *-ubootmod 镜像，仅供已刷社区 mod U-Boot 的设备使用。
# 共享 configs/General.config 已含 CONFIG_TARGET_MULTI_PROFILE=y / CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 使用 opkg 包管理器（与既有 mt798x 配置 RAX3000M.config 保持一致，避免 APK 相关坑）
CONFIG_USE_APK=n

# ===================== mt7981 系列 (stock) =====================
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_abt_asr3000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cetron_ct3003=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cetron_ct3003-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000me=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt2500=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt3000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_jcg_q30-pro=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_nokia_ea0326gmp=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-ubootmod=y

# ===================== mt7986 系列 (stock) =====================
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_bananapi_bpi-r3-mini=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_glinet_gl-mt6000=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_jdcloud_re-cp-03=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_netcore_n60-pro=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-stock=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_tl-xdr6086=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_tl-xdr6088=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_ruijie_rg-x60-pro=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_zyxel_ex5700-telenor=y
